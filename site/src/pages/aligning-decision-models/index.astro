---
import Base from "../../layouts/Base.astro";
import EngineName from "../../components/EngineName.astro";
import OverallTable from "../../components/OverallTable.astro";
import AnthusNote from "../../components/AnthusNote.astro";
import { models, modelById, urls, OWA, CWA, TASK_INFO, taskBySlug, pct, pts, int, overall, isComplete, L, listOf } from "../../lib/site.js";
import { intro } from "../../lib/content.js";
import { lean } from "../../lib/insights.js";

const both = models.filter((m) => isComplete(m.id, OWA) && isComplete(m.id, CWA));
// What a model did with open-world items whose correct answer is unknown.
const onUnknown = (id) => {
  const row = overall(id, OWA).confusion.unknown || {};
  const n = Object.values(row).reduce((a, b) => a + b, 0);
  return { n, unknown: (row.unknown || 0) / n, true: (row.true || 0) / n, false: (row.false || 0) / n };
};
const ignores = both.filter((m) => onUnknown(m.id).unknown < 0.2);
const jev = both.find((m) => m.id === "jev");
const jevBest = jev && both.every((m) => m.id === "jev" || (overall("jev", OWA).accuracy > overall(m.id, OWA).accuracy && overall("jev", CWA).accuracy > overall(m.id, CWA).accuracy));
const ju = jev ? onUnknown("jev") : null;
---
<Base title={intro.aligning.title} description={intro.aligning.intro} path={urls.page("aligning-decision-models")} current={{ page: "aligning" }}
  crumbs={[{ label: "Benchmark", href: urls.home() }, { label: "Aligning decision models" }]}>
  <section class="wrap hero">
    <p class="kicker">Guide · aligning decision models</p>
    <h1 class="display xl">{intro.aligning.title}</h1>
    <p class="deck">{intro.aligning.intro}</p>
  </section>

  <section class="wrap section tight" aria-labelledby="two-h">
    <h2 class="display" id="two-h">Two rules for what cannot be proved</h2>
    <p class="lede">Under the open-world rule, a statement nothing supports is unknown. Under the closed-world rule, it is false. The two tasks state their rule in the question, and each model got the rule for its task.</p>
    <div class="ex-grid">
      <div class="ex-v ex-v1"><span class="ex-l">{TASK_INFO[OWA].long}</span><p class="ex-text">{taskBySlug[OWA].question}</p></div>
      <div class="ex-v"><span class="ex-l">{TASK_INFO[CWA].long}</span><p class="ex-text">{taskBySlug[CWA].question}</p></div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="ow-h">
    <h2 class="display" id="ow-h">Accuracy under each rule</h2>
    <ul class="around-list">
      {both.map((m) => (
        <li><EngineName engine={m} href={urls.model(m.id)} /><span>open world {pct(overall(m.id, OWA).accuracy)}%, closed world {pct(overall(m.id, CWA).accuracy)}%</span><span class="av">{pts(overall(m.id, CWA).accuracy - overall(m.id, OWA).accuracy)}</span></li>
      ))}
    </ul>
    <p class="note">Closed-world minus open-world accuracy, in points. Chance is 50% on the closed-world task and 33% on the open-world one, so higher closed-world numbers are expected; the gap above chance is what to compare.</p>
    <h3>{TASK_INFO[OWA].long}</h3>
    <OverallTable slug={OWA} caption="Open-world results" />
    <h3>{TASK_INFO[CWA].long}</h3>
    <OverallTable slug={CWA} caption="Closed-world results" />
  </section>

  <section class="wrap section" aria-labelledby="unk-h">
    <h2 class="display" id="unk-h">Does the model follow the rule it was given?</h2>
    <p class="lede">On the open-world task, {int(both.length ? onUnknown(both[0].id).n : 0)} items have unknown as the correct answer. What each model said on them:</p>
    <div class="table-scroll">
      <table class="cell-table">
        <thead><tr><th scope="col">Model</th><th scope="col" class="num">Said unknown</th><th scope="col" class="num">Said true</th><th scope="col" class="num">Said false</th></tr></thead>
        <tbody>{both.map((m) => { const u = onUnknown(m.id); return (
          <tr><th scope="row"><EngineName engine={m} href={urls.model(m.id)} /></th><td class="num strong">{pct(u.unknown)}%</td><td class="num">{pct(u.true)}%</td><td class="num">{pct(u.false)}%</td></tr>
        ); })}</tbody>
      </table>
    </div>
    {ignores.length > 0 && <p>{listOf(ignores.map((m) => m.label))} {ignores.length === 1 ? "answers" : "answer"} these items as if the closed-world rule applied, even though the question defines unknown and offers it: {listOf(ignores.map((m) => { const u = onUnknown(m.id); return `${m.label} said false on ${pct(u.false)}%`; }))}. That is not a reasoning failure so much as a different decision from the one asked for, and it is the kind of misalignment that a single accuracy number hides.</p>}
  </section>

  {jev && (
    <section class="wrap section" aria-labelledby="jev-h">
      <h2 class="display" id="jev-h">Aligning Jev</h2>
      <p>Jev scored {pct(overall("jev", OWA).accuracy)}% under the open-world rule and {pct(overall("jev", CWA).accuracy)}% under the closed-world one{jevBest ? ", the highest of the models here under both" : ""}. On unknown items it said true {pct(ju.true)}% of the time and false {pct(ju.false)}%{ju.true > ju.false ? `: when it errs on "not enough information", it leans toward yes` : ""}. If your decision treats "cannot tell" as its own outcome, that is the error to test and correct for first. <a href={urls.model("jev")}>Jev's full results</a>.</p>
    </section>
  )}

  <section class="wrap section" aria-labelledby="how-h">
    <h2 class="display" id="how-h">How to check alignment on your own decisions</h2>
    <ol class="checklist">
      <li>Write the decision rule down, including what "unknown" or "not enough information" means, and put it in the instructions the model gets.</li>
      <li>Build test items where the rule matters: the same facts that should lead to different answers under different rules.</li>
      <li>Look at what the model says on each correct answer, not only its accuracy; a lean toward one answer is a misalignment you can see in one table.</li>
      <li>Change the rule and check the answers move the way they should. A model that answers the same under both rules is not reading the rule.</li>
      <li>Repeat the test after any change of model version, instructions or tuning.</li>
    </ol>
    <p class="more-link"><a href={urls.page("evaluating-decision-models")}>Evaluating decision models</a> · <a href={urls.page("fine-tuning-decision-models")}>Fine-tuning decision models</a></p>
  </section>

  <AnthusNote lead="Anthus AI Solutions made this benchmark. Whether a decision model answers the question you meant is measurable, and worth measuring before it makes decisions for you." />
</Base>
