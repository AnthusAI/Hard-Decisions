---
import Base from "../../layouts/Base.astro";
import EngineName from "../../components/EngineName.astro";
import AnthusNote from "../../components/AnthusNote.astro";
import { modelById, models, urls, OWA, CWA, taskOrder, TASK_INFO, taskBySlug, pct, pts, int, pair, isComplete, ranked, statusWords, L } from "../../lib/site.js";
import { intro, liveComparisons } from "../../lib/content.js";
---
<Base title={intro.compare.title} description={intro.compare.intro} path={urls.compare()} current={{ page: "compare" }}
  crumbs={[{ label: "Benchmark", href: urls.home() }, { label: "Compare" }]}>
  <section class="wrap hero">
    <p class="kicker">Compare</p>
    <h1 class="display xl">{intro.compare.title}</h1>
    <p class="deck">{intro.compare.intro}</p>
  </section>
  <section class="wrap section tight" aria-labelledby="list-h">
    <h2 class="display sm" id="list-h">Comparisons</h2>
    <div class="dim-grid">
      {liveComparisons.map((c) => (
        <a class="dim-card" href={urls.comparison(c.slug)}>
          <div class="dim-card-h">{c.title}</div>
          <p>{c.intro}</p>
          <div class="dim-card-f">{[c.a, ...c.b].filter((id) => modelById[id] && modelById[id].measured).map(L).join(" · ")}</div>
        </a>
      ))}
    </div>
  </section>
  <section class="wrap section" aria-labelledby="acc-h">
    <h2 class="display" id="acc-h">Accuracy on the same problems</h2>
    <div class="two-up">
      {taskOrder.map((s) => (
        <div>
          <h3>Accuracy on {int(taskBySlug[s].n)} {TASK_INFO[s].short.toLowerCase()} problems</h3>
          <ul class="around-list">
            {ranked(s).map(({ m, r, complete }) => <li><EngineName engine={m} href={urls.model(m.id)} /><span>{pct(r.lo)} to {pct(r.hi)}{complete ? "" : `; ${statusWords(m.id, s)}`}</span><span class="av">{pct(r.accuracy)}%</span></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="pairs-h">
    <h2 class="display" id="pairs-h">Jev against every model, on the same items</h2>
    <p class="lede">Jev minus each model, in points, with the 95% interval of the paired difference. Positive means Jev was more accurate.</p>
    <div class="table-scroll">
      <table class="cell-table">
        <thead><tr><th scope="col">Model</th>{taskOrder.map((s) => <Fragment><th scope="col" class="num">{TASK_INFO[s].short}: overall</th><th scope="col" class="num">depth 0</th><th scope="col" class="num">depth 5</th></Fragment>)}</tr></thead>
        <tbody>{models.filter((m) => m.id !== "jev").map((m) => (
          <tr><th scope="row"><EngineName engine={m} href={urls.model(m.id)} /></th>
            {taskOrder.map((s) => { const p = pair(s, "jev", m.id); const r = (axis, v) => p && p.find((x) => x.axis === axis && x.value === v);
              return ["all", "0", "5"].map((v) => { const x = r(v === "all" ? "overall" : "depth", v); return <td class="num">{x ? <Fragment><span class="strong">{pts(x.diff)}</span> <span class="ci-t">{pts(x.ci_low)} to {pts(x.ci_high)}</span>{!isComplete(m.id, s) && <span class="ci-t"> (partial)</span>}</Fragment> : "—"}</td>; }); })}
          </tr>
        ))}</tbody>
      </table>
    </div>
  </section>
  <AnthusNote />
</Base>
