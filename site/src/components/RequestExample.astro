---
// One model's request and response for one problem, from studies/request-examples.json: how it was sent,
// the exact text the model reads, and the full request and response as sent and recorded.
import EngineName from "./EngineName.astro";
import ResultIcon from "./ResultIcon.astro";
import { modelById, urls } from "../lib/site.js";
const { id, ex } = Astro.props;
const e = ex.engines[id];
const m = modelById[id];
const req = e && e.request;
const readsText = req && (req.body.state && req.body.state.text) || (req && req.body.messages && req.body.messages[0].content) || (req && typeof req.body.state === "string" && req.body.state) || (req && req.body.text) || null;
const labels = req && (req.body.questions ? Object.keys(Object.values(req.body.questions)[0].criteria) : req.body.tasks ? Object.values(req.body.tasks)[0] : req.body.response_format ? req.body.response_format.json_schema.schema.properties.answer.enum : null);
const separate = req && req.body.questions ? Object.values(req.body.questions)[0] : null;
const a = e && e.response.answers ? Object.values(e.response.answers)[0] : null;
const pct = (x) => `${(100 * x).toFixed(1)}%`;
---
{e && m && (
<div class="req-card">
  <div class="req-head"><EngineName engine={m} href={urls.model(id)} /><span class="req-verdict"><ResultIcon correct={e.correct} /> answered <strong>{a ? a.choice : "nothing valid"}</strong>{a && a.probabilities && a.choice in a.probabilities ? ` (${pct(a.probabilities[a.choice])})` : ""}; correct answer {ex.gold}</span></div>
  <p class="req-how">{req.how === "HTTP" ? <Fragment><code>{req.method} {req.url}</code></Fragment> : <Fragment>Run on our laptop in Python: <code>{req.call}</code></Fragment>}</p>
  <p class="req-note">{req.note}</p>
  <div class="req-parts">
    <div><p class="req-l">The text the model reads</p><pre class="req-text">{readsText}</pre></div>
    {separate && <div><p class="req-l">The question, sent as its own field</p><pre class="req-text">{separate.instructions}</pre>
      <p class="req-l">The answers it can give, each with its meaning</p><pre class="req-text">{Object.entries(separate.criteria).map(([k, v]) => `${k}: ${v}`).join("\n")}</pre></div>}
    {!separate && labels && <div><p class="req-l">The answers it can give</p><pre class="req-text">{labels.join("\n")}</pre></div>}
  </div>
  {a && a.probabilities && <p class="req-probs">Its probability for each answer: {Object.entries(a.probabilities).map(([k, v]) => `${k} ${pct(v)}`).join(", ")}.</p>}
  <details class="req-raw"><summary>The full request and response, exactly as sent and recorded</summary>
    <p class="req-l">Request</p><pre class="code"><code>{JSON.stringify(req.how === "HTTP" ? req.body : { call: req.call, ...req.body }, null, 2)}</code></pre>
    <p class="req-l">Response (the saved record)</p><pre class="code"><code>{JSON.stringify({ model: e.response.model, answers: e.response.answers, usage: e.response.usage }, null, 2)}</code></pre>
  </details>
</div>
)}
