---
// A model's confusion matrix on one task (rows: the correct answer; columns: what it said).
import { overall, taskBySlug, int, pct } from "../lib/site.js";
const { id, slug } = Astro.props;
const o = overall(id, slug);
const t = taskBySlug[slug];
const cols = [...t.options, ...(o && Object.values(o.confusion || {}).some((r) => r.invalid) ? ["invalid"] : [])];
---
{o && o.confusion && (
  <div class="table-scroll">
    <table class="cell-table confusion">
      <caption class="sr">Correct answer by what the model said</caption>
      <thead><tr><th scope="col">Correct answer</th>{cols.map((c) => <th scope="col" class="num">Said {c}</th>)}<th scope="col" class="num">Recall</th></tr></thead>
      <tbody>{t.options.map((g) => { const row = o.confusion[g] || {}; const n = Object.values(row).reduce((a, b) => a + b, 0); return (
        <tr><th scope="row">{g}</th>{cols.map((c) => <td class={`num${c === g ? " strong" : ""}`}>{int(row[c] || 0)}</td>)}<td class="num">{pct((row[g] || 0) / n)}%</td></tr>
      ); })}</tbody>
    </table>
  </div>
)}
