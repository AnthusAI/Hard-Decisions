---
// A model's marker drawn inside a larger SVG at (cx, cy).
const { engine, cx, cy, r = 5.5 } = Astro.props;
const c = `var(--eng-${engine.slug})`;
---
{engine.marker === "square" ? <rect x={cx - r} y={cy - r} width={2 * r} height={2 * r} rx="1.5" fill={c} stroke="var(--surface)" stroke-width="1.2" />
  : engine.marker === "diamond" ? <path d={`M${cx},${cy - r * 1.3}L${cx + r * 1.3},${cy}L${cx},${cy + r * 1.3}L${cx - r * 1.3},${cy}Z`} fill={c} stroke="var(--surface)" stroke-width="1.2" />
  : engine.marker === "diamond-open" ? <path d={`M${cx},${cy - r * 1.2}L${cx + r * 1.2},${cy}L${cx},${cy + r * 1.2}L${cx - r * 1.2},${cy}Z`} fill="var(--surface)" stroke={c} stroke-width="2.4" />
  : engine.marker === "triangle-down" ? <path d={`M${cx},${cy + r * 1.3}L${cx + r * 1.25},${cy - r}L${cx - r * 1.25},${cy - r}Z`} fill={c} stroke="var(--surface)" stroke-width="1.2" />
  : engine.marker === "triangle" ? <path d={`M${cx},${cy - r * 1.3}L${cx + r * 1.25},${cy + r}L${cx - r * 1.25},${cy + r}Z`} fill={c} stroke="var(--surface)" stroke-width="1.2" />
  : <circle cx={cx} cy={cy} r={r} fill={c} stroke="var(--surface)" stroke-width="1.2" />}
