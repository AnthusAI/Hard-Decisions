---
// Right or wrong at a glance: a green disc with a check, or a red rounded square with an X. The mark is
// white in light mode and dark in dark mode (the --ok-on / --alarm-on tokens), whichever contrasts more.
const { correct, size = 22 } = Astro.props;
const label = correct ? "right" : "wrong";
---
<svg class="ri" width={size} height={size} viewBox="0 0 24 24" role="img" aria-label={label}>
  <title>{label}</title>
  {correct ? <circle class="ri-bg ok" cx="12" cy="12" r="12" /> : <rect class="ri-bg no" x="0" y="0" width="24" height="24" rx="6" />}
  {correct
    ? <path class="ri-mark ok" d="M6.5 12.5l3.6 3.6 7.4-8" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    : <path class="ri-mark no" d="M7.5 7.5l9 9M16.5 7.5l-9 9" fill="none" stroke-width="3" stroke-linecap="round" />}
</svg>
