---
// The preregistration in one line per section, linking to the verdicts on How we measured.
import { urls } from "../lib/site.js";
import { predictionLines } from "../lib/predictions.js";
const { ids } = Astro.props;
const lines = predictionLines(ids);
---
{lines.length > 0 && (
  <ul class="pred-lines">
    {lines.map((l) => <li>{l.text}. <a href={urls.predictions(l.section)}>See How we measured</a>.</li>)}
  </ul>
)}
