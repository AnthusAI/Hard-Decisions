---
// Accuracy against proof depth, one line per model, with 95% intervals and the chance line.
// Static SVG; every number is also in the table that follows it on the page.
import MarkShape from "./MarkShape.astro";
import { modelById, depthRows, taskBySlug, pct, statusWords } from "../lib/site.js";
const { slug, ids, label, compact = false } = Astro.props;
const W = 520, H = compact ? 260 : 300, ml = 44, mr = 14, mt = 14, mb = 40;
const depths = taskBySlug[slug].depths.map(String);
const x = (i) => ml + (i * (W - ml - mr)) / (depths.length - 1);
const y = (v) => mt + (1 - v) * (H - mt - mb);
const chance = 1 / taskBySlug[slug].options.length;
const series = ids.map((id) => ({ m: modelById[id], rows: depthRows(id, slug), partial: !!statusWords(id, slug) })).filter((s) => s.rows.length);
const off = (k) => (k - (series.length - 1) / 2) * 4;
const desc = series.map((s) => `${s.m.label}: ${s.rows.map((r) => `depth ${r.value} ${pct(r.accuracy)}%`).join(", ")}`).join(". ");
---
<figure class="depth-fig">
  <svg class="chart depth-chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${label}. ${desc}.`}>
    <g class="grid">{[0, 0.25, 0.5, 0.75, 1].map((v) => <line x1={ml} x2={W - mr} y1={y(v)} y2={y(v)} />)}</g>
    {[0, 0.25, 0.5, 0.75, 1].map((v) => <text class="tick" x={ml - 8} y={y(v) + 4} text-anchor="end">{v * 100}%</text>)}
    {depths.map((d, i) => <text class="tick" x={x(i)} y={H - mb + 18} text-anchor="middle">{d}</text>)}
    <text class="axis-label" x={(ml + W - mr) / 2} y={H - 4} text-anchor="middle">proof depth (inference steps)</text>
    <line class="floor-line chance" x1={ml} x2={W - mr} y1={y(chance)} y2={y(chance)} />
    <text class="floor-label" x={ml + 6} y={y(chance) + 14} text-anchor="start">chance {pct(chance, 0)}%</text>
    {series.map((s, k) => (
      <g class:list={["series", { partial: s.partial }]}>
        {s.rows.map((r, i) => <line class="whisker" x1={x(i) + off(k)} x2={x(i) + off(k)} y1={y(r.lo)} y2={y(r.hi)} stroke={`var(--eng-${s.m.slug})`} />)}
        <polyline class="edge" fill="none" stroke={`var(--eng-${s.m.slug})`} points={s.rows.map((r, i) => `${x(i) + off(k)},${y(r.accuracy)}`).join(" ")} />
        {s.rows.map((r, i) => <MarkShape engine={s.m} cx={x(i) + off(k)} cy={y(r.accuracy)} />)}
      </g>
    ))}
  </svg>
</figure>
